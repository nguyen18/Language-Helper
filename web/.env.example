# The backend: translating words the pre-built Cheatsheet files don't have (supabase/functions/translate) and
# checking journal entries' grammar (supabase/functions/check-grammar).
# Local: `npx supabase start` from the repo root prints these (API_URL, PUBLISHABLE_KEY); copy this file to
# .env.local (not committed) and fill them in. Hosted: the project's URL and publishable key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
